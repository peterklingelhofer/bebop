.venv/
.venv-extras/
__pycache__/
*.pyc
.DS_Store
output/
.bebop_cache/

# audio + midi artifacts (large binaries; the pipeline regenerates from sources)
*.wav
*.mid
*.midi

# vendor build artifacts (re-build with vendor/build_nnls_chroma.sh)
vendor/vamp-plugin-sdk/build/
vendor/nnls-chroma/build/
vendor/nnls-chroma/*.o
vendor/nnls-chroma/*.dylib
vendor/nnls-chroma/*.bak

# Rust build artifacts (Cargo.lock is committed — bebop_cli is a binary
# crate, so pinning deps for reproducibility is the right call)
bebop-rs/target/

# AU plugin build artifacts
bebop-au/build/

# Vendored AudioUnitSDK is a git submodule-style dependency — committed via
# git but build outputs from xcodebuild are gitignored above
