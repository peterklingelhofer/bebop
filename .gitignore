.venv/
.venv-extras/
__pycache__/
*.pyc
.DS_Store
output/
.bebop_cache/

# audio + midi artifacts (large binaries; the pipeline regenerates from sources)
*.wav
*.mid
*.midi

# Third-party plugin sources are cloned/built locally by
# vendor/build_nnls_chroma.sh and must NEVER be committed. Ignore the entire
# clone targets so a stray `git add` can't redistribute the BSD (Vamp SDK) or
# GPL (NNLS-Chroma) source trees. Only build_nnls_chroma.sh is tracked here.
vendor/vamp-plugin-sdk/
vendor/nnls-chroma/

# Rust build artifacts (Cargo.lock is committed — bebop_cli is a binary
# crate, so pinning deps for reproducibility is the right call)
bebop-rs/target/

# AU plugin build artifacts
bebop-au/build/

# Vendored AudioUnitSDK is a git submodule-style dependency — committed via
# git but build outputs from xcodebuild are gitignored above
